/* ---- LITERALS AND IDENTIFIERS ---- */

<DEFAULT, IN_DOLLAR_BODY> TOKEN :
{
  <NUMBER:
      <DIGITS> ("." (<DIGITS>)?)? (<EXPONENT>)?
    | "." <DIGITS> (<EXPONENT>)?
    | "0" ["x", "X"] (["0"-"9", "a"-"f", "A"-"F", "_"])+
    | "0" ["o", "O"] (["0"-"7", "_"])+
    | "0" ["b", "B"] (["0", "1", "_"])+
  >
| <#DIGITS: ["0"-"9"] (["0"-"9", "_"])*>
| <#EXPONENT: ["e", "E"] (["+", "-"])? <DIGITS>>

  // positional parameter: $1
| <PARAMETER: "$" (["0"-"9"])+>

  // 'abc'  N'abc'  E'abc\n'  U&'abc'  B'0101'  X'1F'
| <STRING_LITERAL:
      (["n", "N"])? "'" (~["'"] | "''")* "'"
    | ["e", "E"] "'" (~["'", "\\"] | "\\" ~[] | "''")* "'"
    | ["u", "U"] "&" "'" (~["'"] | "''")* "'"
    | ["b", "B", "x", "X"] "'" (~["'"])* "'"
  >

| <QUOTED_IDENTIFIER: (["u", "U"] "&")? "\"" (~["\""] | "\"\"")* "\"">

| <#ID_START: ["a"-"z", "A"-"Z", "_", "\u0080"-"￿"]>
| <#ID_CONT: ["a"-"z", "A"-"Z", "0"-"9", "_", "$", "\u0080"-"￿"]>
| <#ID_START_NO_DOLLAR: ["a"-"z", "A"-"Z", "_", "\u0080"-"￿"]>
| <#ID_CONT_NO_DOLLAR: ["a"-"z", "A"-"Z", "0"-"9", "_", "\u0080"-"￿"]>
}

<DEFAULT> TOKEN :
{
  <IDENTIFIER: <ID_START> (<ID_CONT>)*>
}

// PostgreSQL searches the raw text for the closing tag of a dollar-quoted string, so the tag closes the string even if
// it directly follows an identifier, as in "END$$". Therefore, "$" can't continue an identifier inside a body.
<IN_DOLLAR_BODY> TOKEN :
{
  <BODY_IDENTIFIER: <ID_START> (<ID_CONT_NO_DOLLAR>)*>
}

/* ---- CATCH-ALL ---- */

// Dollar-quoted bodies can be written in any language, and psql command arguments can be anything. Never fail
// with a lexical error on a stray character.
<DEFAULT, IN_DOLLAR_BODY> TOKEN :
{
  <OTHER: ~[]>
}

<IN_PSQL_COMMAND> TOKEN :
{
  <PSQL_OTHER: ~[]>
}
