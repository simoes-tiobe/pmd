/**
 * Token-only (lexer) JavaCC grammar for PostgreSQL SQL / PL/pgSQL / psql scripts, used by CPD.
 *
 * No parser is generated (BUILD_PARSER=false). The unquoted keywords were generated from
 * PostgreSQL's src/include/parser/kwlist.h (REL_19_STABLE), see the KEYWORDS section below.
 *
 * Lexical states:
 *
 *   DEFAULT               Plain SQL, and psql scripts.
 *   IN_DOLLAR_BODY        Inside a dollar-quoted string ($$ ... $$ or $tag$ ... $tag$). The body is tokenized as
 *                         SQL, so that CPD can find duplicates inside PL/pgSQL function bodies. Like psql, we do not
 *                         recognize backslash commands or COPY data in there. Only the same tag closes the body;
 *                         other tags inside are ordinary tokens (dollar-quoted strings do not nest in PostgreSQL).
 *   IN_BLOCK_COMMENT      Block comments, which nest in PostgreSQL (unlike in Oracle).
 *   IN_PSQL_COMMAND       Arguments of a psql backslash meta-command (\c, \d+, \set, \copy, ...). Ends at the end of
 *                         the line or at the next unquoted double-backslash.
 *   IN_COPY_DATA*         Inline data of COPY ... FROM STDIN (or \copy ... from stdin), up to a line holding "\.".
 *                         The data is skipped entirely.
 *
 * The state flags in TOKEN_MGR_DECLS are only updated by the token actions of a handful of tokens (COPY, STDIN, ';',
 * dollar quotes, psql commands and words, end of line).
 */
options {
  BUILD_PARSER=false;
  CACHE_TOKENS=true;
  UNICODE_INPUT=true;
  IGNORE_CASE=true;
}

PARSER_BEGIN(PostgreSQLParserImpl)
package net.sourceforge.pmd.lang.postgresql.ast;

public class PostgreSQLParserImpl {

}

PARSER_END(PostgreSQLParserImpl)

TOKEN_MGR_DECLS :
{
    /** Nesting depth of the block comment being read. */
    private int commentDepth = 0;
    /** The tag (eg "$$" or "$body$") of the dollar-quoted string we're in, null if not in one. */
    private String dollarTag = null;
    /** A COPY keyword was seen in the current statement. */
    private boolean sawCopy = false;
    /** A STDIN keyword was seen in a statement with a COPY keyword. */
    private boolean sawStdin = false;
    /** The current psql command is \copy. */
    private boolean inCopyCommand = false;
    /** Inline COPY data starts after the next end of line. */
    private boolean copyDataPending = false;
}

/* ---- WHITESPACE ---- */

<DEFAULT, IN_DOLLAR_BODY, IN_PSQL_COMMAND> SKIP :
{
  " "
| "\t"
| "\f"
}

<DEFAULT, IN_DOLLAR_BODY> SKIP :
{
  <EOL: "\r\n" | "\n" | "\r">
  {
    if (copyDataPending && dollarTag == null) {
      copyDataPending = false;
      SwitchTo(IN_COPY_DATA_START);
    }
  }
}

/* ---- COMMENTS ---- */

<DEFAULT, IN_DOLLAR_BODY> SPECIAL_TOKEN :
{
  <SINGLE_LINE_COMMENT: "--" (~["\r", "\n"])*>
}

<DEFAULT, IN_DOLLAR_BODY> MORE :
{
  "/*" { commentDepth = 1; } : IN_BLOCK_COMMENT
}

<IN_BLOCK_COMMENT> MORE :
{
  "/*" { commentDepth++; }
| "*/"
  {
    commentDepth--;
    if (commentDepth == 0) {
      // un-read the closing delimiter, it's read again as the final token
      input_stream.backup(2);
      SwitchTo(IN_BLOCK_COMMENT_END);
    }
  }
| < ~[] >
}

<IN_BLOCK_COMMENT_END> SPECIAL_TOKEN :
{
  <BLOCK_COMMENT: "*/"> { SwitchTo(dollarTag == null ? DEFAULT : IN_DOLLAR_BODY); }
}

/* ---- COPY ... FROM STDIN inline data ---- */

<IN_COPY_DATA_START> SKIP :
{
  // the first line of data is already the end marker
  <COPY_DATA_EMPTY_END: "\\." ([" ", "\t"])* ("\r\n" | "\n" | "\r")?> : DEFAULT
| < ~[] > : IN_COPY_DATA
}

<IN_COPY_DATA> SKIP :
{
  <COPY_DATA_END: ("\r\n" | "\n" | "\r") "\\." ([" ", "\t"])* ("\r\n" | "\n" | "\r")?> : DEFAULT
| < ~[] >
}

/* ---- PSQL BACKSLASH COMMANDS ---- */

<DEFAULT> TOKEN :
{
  // eg \c \d+ \dt \set \copy \if \! \;
  <PSQL_COMMAND: "\\" (~[" ", "\t", "\f", "\r", "\n", "\\", "'", "\"", "`"])+>
  { inCopyCommand = matchedToken.getImage().equals("\\copy"); } : IN_PSQL_COMMAND
}

<DEFAULT, IN_PSQL_COMMAND> TOKEN :
{
  // ends the current command, the rest of the line is processed as a new input
  <PSQL_SEPARATOR: "\\\\"> { inCopyCommand = false; } : DEFAULT
}

<IN_PSQL_COMMAND> SKIP :
{
  <PSQL_EOL: "\r\n" | "\n" | "\r">
  {
    inCopyCommand = false;
    if (copyDataPending) {
      copyDataPending = false;
      SwitchTo(IN_COPY_DATA_START);
    } else {
      SwitchTo(DEFAULT);
    }
  }
}

<DEFAULT, IN_PSQL_COMMAND> TOKEN :
{
  // :name  :'name'  :"name"  :{?name}
  <PSQL_VARIABLE:
      ":" <ID_START> (<ID_CONT_NO_DOLLAR>)*
    | ":'" (~["'", "\r", "\n"])+ "'"
    | ":\"" (~["\"", "\r", "\n"])+ "\""
    | ":{?" (<ID_CONT_NO_DOLLAR>)+ "}"
  >
}

<IN_PSQL_COMMAND> TOKEN :
{
  <PSQL_STRING: "'" (~["'", "\\", "\r", "\n"] | "\\" ~["\r", "\n"] | "''")* "'">
| <PSQL_QUOTED: "\"" (~["\"", "\r", "\n"] | "\"\"")* "\"">
| <PSQL_BACKTICK: "`" (~["`", "\r", "\n"])* "`">
| <PSQL_WORD: (~[" ", "\t", "\f", "\r", "\n", "\\", "'", "\"", "`", ";"])+>
  {
    if (inCopyCommand) {
      String word = matchedToken.getImage();
      if (word.equalsIgnoreCase("stdin") || word.equalsIgnoreCase("pstdin")) {
        copyDataPending = true;
      }
    }
  }
}

/* ---- PUNCTUATION ---- */

<DEFAULT, IN_DOLLAR_BODY, IN_PSQL_COMMAND> TOKEN :
{
  <SEMICOLON: ";">
  {
    if (dollarTag == null) {
      if (sawCopy && sawStdin) {
        copyDataPending = true;
      }
      sawCopy = false;
      sawStdin = false;
    }
  }
}

<DEFAULT, IN_DOLLAR_BODY> TOKEN :
{
  <LPAREN: "(">
| <RPAREN: ")">
| <LBRACKET: "[">
| <RBRACKET: "]">
| <COMMA: ",">
| <DOT: ".">
| <DOTDOT: "..">
| <COLON: ":">
}

/*
 * Operators. Only the common multi-character ones are listed, other sequences of operator characters are split into
 * single-character tokens. This is fine for CPD, and it makes sure the start of a comment ("--" or "/*") is never
 * swallowed by an operator.
 */
<DEFAULT, IN_DOLLAR_BODY> TOKEN :
{
  <OPERATOR:
      "::" | ":=" | "=>" | "->" | "->>" | "#>" | "#>>" | "#-" | "@>" | "<@" | "||" | "&&"
    | "!=" | "<>" | "<=" | ">=" | "<<" | ">>" | "@@" | "@?" | "?|" | "?&" | "<->"
    | "~~" | "~~*" | "!~~" | "!~~*" | "!~" | "!~*" | "~*"
    | ["+", "-", "*", "/", "<", ">", "=", "~", "!", "@", "#", "%", "^", "&", "|", "?"]
  >
}

/* ---- DOLLAR QUOTING ---- */

<DEFAULT, IN_DOLLAR_BODY> TOKEN :
{
  // $$  $tag$
  <DOLLAR_QUOTE: "$" (<ID_START_NO_DOLLAR> (<ID_CONT_NO_DOLLAR>)*)? "$">
  {
    String tag = matchedToken.getImage();
    if (dollarTag == null) {
      dollarTag = tag;
      SwitchTo(IN_DOLLAR_BODY);
    } else if (dollarTag.equals(tag)) {
      dollarTag = null;
      SwitchTo(DEFAULT);
    }
  }
}

/* ---- KEYWORDS ---- */

<DEFAULT, IN_DOLLAR_BODY> TOKEN :
{
  <K_ABORT: "abort">
| <K_ABSENT: "absent">
| <K_ABSOLUTE: "absolute">
